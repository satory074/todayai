---
/**
 * 絞り込み UI。
 *   1) 固定のチップバー（#source-filter）: すべて/X/公式/はてブ/LayerX/Zenn/Qiita（SECTIONS。公式＝Workspace＋GCP）。
 *      1 行・横スクロール。画面上端に固定するのはこれ 1 本だけ（＋各日の固定の日付札）。
 *   2) 絞り込みの文脈（#filter-context、固定しない）: X のアカウント行と出典リンク。
 *      かつてはチップバーの 2・3 段目に入れていて、X を選ぶと固定領域がスマホ画面の 41% を占めた。
 *
 * 状態は URL（?s=セクション&a=@handle）に反映＝リロード・共有・戻るで復元される。
 * JS 無効時はチップバーごと隠す（押しても何も起きないボタンを出さない）。本文はそのまま読める。
 */
import {
  SECTIONS,
  SECTION_OF,
  SOURCES,
  avatarColor,
  avatarInitials,
  xAccountsOf,
  type FeedItem,
} from "@/lib/feed";

interface Props {
  items: FeedItem[];
}
const { items } = Astro.props;

const counts = new Map<string, number>();
for (const item of items) {
  const key = SECTION_OF[item.source];
  counts.set(key, (counts.get(key) ?? 0) + 1);
}
// 0 件のセクションはチップを出さない（押しても空になるだけ）
const chips = [
  { key: "all", label: "すべて", count: items.length },
  ...SECTIONS.filter((s) => counts.get(s.key)).map((s) => ({
    key: s.key,
    label: s.label,
    count: counts.get(s.key) ?? 0,
  })),
];

// X のアカウント絞り込み（第2軸）。このページに実際に描画されるアイテムから導出する
// ＝ feeds.config.ts の x.accounts には無いブックマーク由来のアカウントも拾える。
const xAccounts = xAccountsOf(items);
const xCount = counts.get("x") ?? 0;
// 月別アーカイブは distinct 40 前後まで伸びる（大半は1件）ので、初期表示は上位のみ。
const ACCOUNT_CHIP_LIMIT = 12;
const extraAccountCount = Math.max(0, xAccounts.length - ACCOUNT_CHIP_LIMIT);
---

<div id="source-filter" class="chipbar -mx-4 px-4 sm:-mx-6 sm:px-6">
  <div class="chipbar-track" role="group" aria-label="ソースで絞り込み">
    {
      chips.map((c) => (
        <button type="button" class="chip" data-filter={c.key} aria-pressed={c.key === "all" ? "true" : "false"}>
          {c.label}
          <span class="chip-count">{c.count}</span>
        </button>
      ))
    }
  </div>
</div>
<noscript><style>#source-filter{display:none}</style></noscript>

<div id="filter-context" class="filter-context">
  {
    xAccounts.length > 0 && (
      <div data-account-row hidden role="group" aria-label="X のアカウントで絞り込み" class="account-row">
        <span class="filter-context-label">アカウント</span>
        <button type="button" class="chip chip-sm" data-account="all" aria-pressed="true">
          すべて<span class="chip-count">{xCount}</span>
        </button>
        {xAccounts.map((a, i) => (
          <button
            type="button"
            class:list={["chip chip-sm chip-account", i >= ACCOUNT_CHIP_LIMIT && "is-extra"]}
            data-account={a.key}
            data-handle={a.handle}
            data-label={a.label}
            aria-pressed="false"
          >
            <span
              class="avatar avatar-xs"
              style={`background:${a.handle ? avatarColor(a.handle) : "var(--color-avatar-fallback)"}`}
              aria-hidden="true"
            >
              {a.handle ? avatarInitials(a.handle) : "?"}
              {a.avatarUrl && (
                <img src={a.avatarUrl} alt="" width="20" height="20" loading="lazy" decoding="async" onerror="this.remove()" />
              )}
            </span>
            <span class="chip-account-name">{a.label}</span>
            <span class="chip-count">{a.count}</span>
          </button>
        ))}
        {extraAccountCount > 0 && (
          <button type="button" class="chip chip-sm chip-more" data-account-more>
            他{extraAccountCount}件
          </button>
        )}
      </div>
    )
  }

  <!-- 出典元。選択中のセクション（公式は Workspace と GCP の 2 本）またはアカウントの分だけ表示。
       外部 URL なので siteLink() は通さない。 -->
  <div data-origin-row hidden class="origin-row">
    {
      SOURCES.map((s) => (
        <p data-origin={s.key} data-origin-section={SECTION_OF[s.key]} hidden>
          <span class="filter-context-label">出典</span>
          <a href={s.originUrl} target="_blank" rel="noopener noreferrer" class="origin-link">
            {s.originLabel} <span aria-hidden="true">↗</span>
          </a>
          {s.originNote && <span>{s.originNote}</span>}
        </p>
      ))
    }
    <!-- X はアカウント選択中だけプロフィールへ差し替える（href/文言は JS が入れる） -->
    <p data-origin="x-account" hidden>
      <span class="filter-context-label">出典</span>
      <a data-origin-x-link href="https://x.com/" target="_blank" rel="noopener noreferrer" class="origin-link">
        <span data-origin-x-label>x.com</span> <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>
</div>

<script>
  import { X_ACCOUNT_OTHER } from "@/lib/feed";

  const sectionChips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const accountChips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-account]"));
  const accountRow = document.querySelector<HTMLElement>("[data-account-row]");
  const originRow = document.querySelector<HTMLElement>("[data-origin-row]");
  const originBlocks = Array.from(document.querySelectorAll<HTMLElement>("[data-origin]"));
  const originXLink = document.querySelector<HTMLAnchorElement>("[data-origin-x-link]");
  const originXLabel = document.querySelector<HTMLElement>("[data-origin-x-label]");
  const context = document.getElementById("filter-context");
  const days = Array.from(document.querySelectorAll<HTMLElement>("[data-day]"));
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-feed-item]"));

  const validSections = new Set(sectionChips.map((c) => c.dataset.filter));
  const validAccounts = new Set(accountChips.map((c) => c.dataset.account));

  // 絞り込みは2軸: ①チップ（行の data-sec）×②X のアカウント（X の行にだけ効く＝他ソースは出したまま）
  let sectionFilter = "all";
  let accountFilter = "all";

  function applyFilters() {
    for (const row of rows) {
      const offSection = sectionFilter !== "all" && row.dataset.sec !== sectionFilter;
      const offAccount = accountFilter !== "all" && row.dataset.source === "x" && row.dataset.xAccount !== accountFilter;
      row.hidden = offSection || offAccount;
    }
    // 「すべて」以外を選んだら、トップの折りたたみ（はてブ・Zenn・Qiita の 3 日目以降）を解除して全日出す。
    // globals.css が :root.filter-active を見て is-collapsed を表示し、「もっと見せる」ボタンを隠す。
    document.documentElement.classList.toggle("filter-active", sectionFilter !== "all");
    // 該当行が 1 件も無い日は日付札ごと隠す
    for (const day of days) day.hidden = !day.querySelector("[data-feed-item]:not([hidden])");

    for (const chip of sectionChips) {
      chip.setAttribute("aria-pressed", String(chip.dataset.filter === sectionFilter));
    }
    for (const chip of accountChips) {
      chip.setAttribute("aria-pressed", String(chip.dataset.account === accountFilter));
    }
    syncAccountRow();
    syncOriginRow();
    syncUrl();
  }

  // アカウント行は「X 選択中」か「アカウント選択中」に出す。
  // 後者を条件に入れないと、X → すべて に戻したときに絞り込みだけ残って行が消える（見えない絞り込み）。
  function syncAccountRow() {
    if (accountRow) accountRow.hidden = !(sectionFilter === "x" || accountFilter !== "all");
  }

  // 出典行: アカウント選択中はそのプロフィール、そうでなければ選択中セクションの出典元。
  function syncOriginRow() {
    const handle = accountFilter !== "all" && accountFilter !== X_ACCOUNT_OTHER ? accountFilter.slice(1) : null;
    if (handle && originXLink && originXLabel) {
      const chip = accountChips.find((c) => c.dataset.account === accountFilter);
      originXLink.href = `https://x.com/${handle}`;
      originXLabel.textContent = `${chip?.dataset.label ?? `@${handle}`}（@${handle}）を X で見る`;
    }
    let any = false;
    for (const block of originBlocks) {
      const show = handle
        ? block.dataset.origin === "x-account"
        : sectionFilter !== "all" && block.dataset.originSection === sectionFilter;
      block.hidden = !show;
      any ||= show;
    }
    if (originRow) originRow.hidden = !any;
  }

  function syncUrl() {
    const url = new URL(location.href);
    if (sectionFilter === "all") url.searchParams.delete("s");
    else url.searchParams.set("s", sectionFilter);
    if (accountFilter === "all") url.searchParams.delete("a");
    else url.searchParams.set("a", accountFilter);
    if (url.href !== location.href) history.replaceState(history.state, "", url);
  }

  // 下へ読み進めた状態でチップを押したら、絞り込み結果の先頭（アカウント行・出典の位置）へ戻す
  function revealResults() {
    if (context && context.getBoundingClientRect().top < 0) context.scrollIntoView({ block: "start" });
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const sectionChip = target.closest<HTMLButtonElement>("[data-filter]");
    if (sectionChip?.dataset.filter) {
      sectionFilter = sectionChip.dataset.filter;
      applyFilters();
      revealResults();
      return;
    }

    const accountChip = target.closest<HTMLButtonElement>("[data-account]");
    if (accountChip?.dataset.account) {
      accountFilter = accountChip.dataset.account;
      applyFilters();
      revealResults();
      return;
    }

    // 上限を超えたアカウントチップを展開（以後は畳み直さない）
    const more = target.closest<HTMLElement>("[data-account-more]");
    if (more) {
      for (const chip of accountChips) chip.classList.remove("is-extra");
      more.remove();
    }
  });

  // URL の状態を復元（不正値は捨てて URL からも消す）
  const params = new URLSearchParams(location.search);
  const s = params.get("s");
  const a = params.get("a");
  if (s && validSections.has(s)) sectionFilter = s;
  if (a && validAccounts.has(a)) accountFilter = a;
  if (accountFilter !== "all" && accountChips.some((c) => c.dataset.account === accountFilter && c.classList.contains("is-extra"))) {
    for (const chip of accountChips) chip.classList.remove("is-extra");
    document.querySelector("[data-account-more]")?.remove();
  }
  applyFilters();
</script>
