---
import ArticleRow from "./ArticleRow.astro";
import TweetRow from "./TweetRow.astro";
import { groupByDay, sourceLabel, LIMITED_SOURCES, type FeedItem } from "@/lib/feed";

interface Props {
  items: FeedItem[];
  /** トップ専用: 初期折りたたみ対象の id（「もっと見せる」で展開）。未指定（アーカイブ）なら全件表示 */
  collapsedIds?: Set<string>;
}

const { items, collapsedIds } = Astro.props;
const groups = groupByDay(items);
const showMoreLabel = LIMITED_SOURCES.map(sourceLabel).join("・");
---

<!-- 日付グルーピング＋リスト行。data-day-section / data-feed-item / data-source / data-x-account と
     is-collapsed / data-show-more-row は SourceFilter のスクリプト・CSS が出し分けに使うので変えないこと。
     行（ArticleRow / TweetRow の <article>）自身が data-feed-item を持つ。 -->
<div class="space-y-8">
  {
    groups.map((group) => {
      const collapsedCount = collapsedIds
        ? group.items.filter((i) => collapsedIds.has(i.id)).length
        : 0;
      return (
        <section data-day-section>
          <h2 class="sticky top-[var(--stack-h)] z-[5] mb-1 inline-flex items-center rounded-md bg-[var(--color-card)] px-2.5 py-1 font-mono text-xs font-semibold tracking-wide text-[var(--color-text-muted)] shadow-[0_1px_2px_rgba(20,22,27,0.05)] ring-1 ring-[var(--color-border)]">
            {group.label}
          </h2>
          <div class="row-list">
            {group.items.map((item) =>
              item.source === "x" ? (
                <TweetRow item={item} />
              ) : (
                <ArticleRow item={item} collapsed={collapsedIds?.has(item.id)} />
              ),
            )}
            {collapsedCount > 0 && (
              <div data-show-more-row class="py-3">
                <button
                  type="button"
                  data-show-more
                  class="inline-flex items-center gap-1 rounded-full border border-[var(--color-border)] bg-[var(--color-card)] px-3 py-1.5 text-[0.78125rem] font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-text)]"
                >
                  {showMoreLabel} をもっと見せる（<span class="font-mono tabular-nums">{collapsedCount}</span>件）
                </button>
              </div>
            )}
          </div>
        </section>
      );
    })
  }
</div>

<script>
  // 「もっと見せる」: その日の折りたたみ分（is-collapsed）を展開してボタン行ごと消す。
  // is-collapsed を DOM から除去する＝以後はフィルタを往復しても通常アイテムとして扱われる。
  // アーカイブページでは data-show-more が無いので no-op。
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-show-more]")) {
    btn.addEventListener("click", () => {
      const section = btn.closest("[data-day-section]");
      if (!section) return;
      for (const item of section.querySelectorAll("[data-feed-item].is-collapsed")) {
        item.classList.remove("is-collapsed");
      }
      btn.closest("[data-show-more-row]")?.remove();
    });
  }
</script>
