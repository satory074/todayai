---
/**
 * 日ごと×ソース別セクション（朝刊型）。
 *   section[data-day]            日（h2）
 *     section[data-section=…]    ソース別の段（固定見出し h3。日付入り＝スクロール中もどの日か分かる）
 *       行（ArticleRow / TweetRow、h4）× 先頭 N 件
 *       <details data-more>      「残り N 件」（ネイティブ。JS 不要・ページ内検索で開く・Safari 可）
 *
 * data-day / data-section / data-feed-item / data-source / data-x-account / data-more / data-count /
 * data-more-count は SourceFilter のスクリプトが絞り込みに使うので変えないこと。
 */
import ArticleRow from "./ArticleRow.astro";
import TweetRow from "./TweetRow.astro";
import { groupDaySections, type FeedItem } from "@/lib/feed";

interface Props {
  items: FeedItem[];
  /** true（トップ）なら各セクションを先頭数件＋「残り N 件」に畳む。アーカイブは false（全件表示） */
  collapse?: boolean;
}

const { items, collapse = false } = Astro.props;
const days = groupDaySections(items, { collapse });

// 2 日目以降は content-visibility:auto で画面外の描画を省く（1 日目＝初期表示域には付けない）。
// 未描画時のプレースホルダ高は「見えている行数 × 平均行高」で見積もる（ずれても auto で実高を記憶）。
const estimateRem = (day: (typeof days)[number]) =>
  day.sections.reduce((sum, s) => sum + 2 + s.head.length * 5.75 + (s.rest.length ? 2.5 : 0), 3);
---

<div class="days">
  {
    days.map((day) => (
      <section data-day id={`d-${day.key}`} class="day" style={`--day-est:${estimateRem(day)}rem`}>
        <h2 class="day-heading">
          <time datetime={day.key} data-day-label>
            {day.label}
          </time>
        </h2>
        {day.sections.map((sec) => (
          <section data-section={sec.def.key} class="sec">
            <h3 class="sec-bar">
              <span class="sec-name">{sec.def.heading}</span>
              <span class="sec-count">
                <span data-count>{sec.head.length + sec.rest.length}</span>件
              </span>
              <span class="sec-day" aria-hidden="true">
                {day.short}
              </span>
            </h3>
            {sec.head.map((item) =>
              item.source === "x" ? <TweetRow item={item} /> : <ArticleRow item={item} badge={sec.def.badge} />,
            )}
            {sec.rest.length > 0 && (
              <details class="more" data-more>
                <summary>
                  <span class="more-label">
                    <span class="sr-only">
                      {day.label} {sec.def.heading}の
                    </span>
                    <span class="more-closed">
                      残り <span data-more-count>{sec.rest.length}</span> 件を表示
                    </span>
                    <span class="more-open">折りたたむ</span>
                  </span>
                </summary>
                {sec.rest.map((item) =>
                  item.source === "x" ? (
                    <TweetRow item={item} />
                  ) : (
                    <ArticleRow item={item} badge={sec.def.badge} />
                  ),
                )}
              </details>
            )}
          </section>
        ))}
      </section>
    ))
  }
</div>
