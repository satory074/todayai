---
/**
 * 時系列タイムライン。その日の全ソースを時刻の新しい順に混ぜて並べる。
 *   section[data-day]          日（固定の日付札 h2）
 *     div[data-feed-item]      行＝左に時刻レール、右に縦線とカード（FeedCard / TweetCard、h3）
 *     [data-show-more-row]     トップの 3 日目以降だけ「はてブ・Zenn・Qiita をもっと見せる（N件）」
 *
 * data-day / data-feed-item / data-source / data-sec / data-x-account と is-collapsed / data-show-more-row は
 * SourceFilter のスクリプトと globals.css が絞り込み・折りたたみに使うので変えないこと。
 *
 * 末尾の script は閲覧時の補正: 「今日/昨日」と更新時刻の相対表記（ビルド時に決めると 6 時間ごとの
 * 静的ビルドなのでずれる）、トップだけ「前回以降の新着」（data-k と localStorage の既読集合を比較）。
 */
import FeedCard from "./FeedCard.astro";
import {
  LIMITED_SOURCES,
  SECTION_OF,
  groupByDay,
  itemKey,
  sourceLabel,
  timeOfDay,
  xAccountKey,
  type FeedItem,
} from "@/lib/feed";

interface Props {
  items: FeedItem[];
  /** トップ専用: 初期折りたたみ対象の id（「もっと見せる」で展開）。未指定（アーカイブ）なら全件表示 */
  collapsedIds?: Set<string>;
  /** true（トップ）なら「前回以降の新着」に印を付ける */
  markNew?: boolean;
}

const { items, collapsedIds, markNew = false } = Astro.props;
const days = groupByDay(items);
const showMoreLabel = LIMITED_SOURCES.map(sourceLabel).join("・");
const isCollapsed = (item: FeedItem) => !!collapsedIds?.has(item.id);

// 2 日目以降は content-visibility:auto で画面外の描画を省く（1 日目＝初期表示域には付けない）。
// 未描画時のプレースホルダ高は「畳まれていない行のカード種別ごとの目安高」の合計で見積もる
// （ずれても auto で一度描画した実高を記憶する）。
const cardEstimateRem = (item: FeedItem) => (item.source === "x" ? 17 : item.thumbnail ? 18 : 7.5) + 0.75;
const estimateRem = (list: FeedItem[]) =>
  list.reduce((sum, item) => sum + (isCollapsed(item) ? 0 : cardEstimateRem(item)), 3);
---

<!-- X ロゴ（TweetCard が <use href="#x-logo"> で参照）。件数分の path を出さないために 1 回だけ置く -->
<svg width="0" height="0" class="absolute" aria-hidden="true">
  <symbol id="x-logo" viewBox="0 0 24 24">
    <path
      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
    ></path>
  </symbol>
</svg>
<!-- JS 無効時は「もっと見せる」が押せないので最初から全部出す -->
<noscript><style>.tl-row.is-collapsed{display:grid!important}[data-show-more-row]{display:none!important}</style></noscript>

<div class="days">
  {
    days.map((day) => {
      const collapsedCount = day.items.filter(isCollapsed).length;
      return (
        <section data-day id={`d-${day.key}`} class="day" style={`--day-est:${estimateRem(day.items)}rem`}>
          <h2 class="day-heading">
            <time datetime={day.key} data-day-label>
              {day.label}
            </time>
            {markNew && <span class="new-pill" data-day-new hidden />}
          </h2>
          <div class="day-items">
            {day.items.map((item) => (
              <div
                class:list={["tl-row", isCollapsed(item) && "is-collapsed"]}
                data-feed-item
                data-source={item.source}
                data-sec={SECTION_OF[item.source]}
                data-x-account={item.source === "x" ? xAccountKey(item) : undefined}
                data-k={markNew ? itemKey(item.id) : undefined}
              >
                <time class="tl-time" datetime={item.publishedAt}>
                  {timeOfDay(item.publishedAt)}
                </time>
                <div class="tl-card">
                  <FeedCard item={item} />
                </div>
              </div>
            ))}
            {collapsedCount > 0 && (
              <div class="tl-row" data-show-more-row>
                <span />
                <div class="tl-card">
                  <button type="button" class="show-more" data-show-more>
                    {showMoreLabel} をもっと見せる（<span class="tabular-nums">{collapsedCount}</span>件）
                    {markNew && <span class="new-pill" data-more-new hidden />}
                  </button>
                </div>
              </div>
            )}
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import { dayKey, relativeTime } from "@/lib/feed";

  // ===== 閲覧時の日付補正 =====
  // ビルド時は「11月14日(土)」「11/14 14:29 更新」の絶対表記だけを出しておき、ここで
  // 「今日」「昨日」と「N時間前」を足す（JST 暦日。dayKey/relativeTime は Asia/Tokyo 固定）。
  function refreshDates() {
    const now = new Date();
    const today = dayKey(now.toISOString());
    const yesterday = dayKey(new Date(now.getTime() - 86400000).toISOString());
    for (const day of document.querySelectorAll<HTMLElement>("[data-day]")) {
      const key = day.id.slice(2); // "d-2026-11-14"
      const rel = key === today ? "今日" : key === yesterday ? "昨日" : "";
      const el = day.querySelector<HTMLElement>("[data-day-label]");
      if (!el) continue;
      el.dataset.abs ??= el.textContent?.trim() ?? "";
      el.textContent = rel ? `${rel} ${el.dataset.abs}` : el.dataset.abs;
    }
    const updated = document.querySelector<HTMLTimeElement>("[data-updated]");
    if (updated) {
      updated.dataset.abs ??= updated.textContent?.trim() ?? "";
      updated.title = updated.dataset.abs;
      updated.textContent = relativeTime(updated.dateTime, now) || updated.dataset.abs;
    }
  }
  refreshDates();
  // 開きっぱなしのタブに戻ってきたときも合わせ直す（日付をまたいだ・数時間経った）
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") refreshDates();
  });

  // ===== 「もっと見せる」=====
  // その日の折りたたみ分（is-collapsed）を展開してボタン行ごと消す。is-collapsed を DOM から外す＝
  // 以後はフィルタを往復しても通常の行として扱われる。アーカイブには data-show-more が無いので何もしない。
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-show-more]")) {
    btn.addEventListener("click", () => {
      const day = btn.closest("[data-day]");
      if (!day) return;
      const revealed = Array.from(day.querySelectorAll<HTMLElement>("[data-feed-item].is-collapsed"));
      for (const row of revealed) row.classList.remove("is-collapsed");
      btn.closest("[data-show-more-row]")?.remove();
      // 押したボタンが消えるので、フォーカスを開いた先頭の行へ移す（body に落とさない）
      revealed[0]?.querySelector<HTMLAnchorElement>(".card-link")?.focus({ preventScroll: true });
    });
  }

  // ===== 前回以降の新着（トップだけ。行に data-k があるときだけ動く）=====
  // 時刻ではなく「前回見たページに載っていたか」で判定する: X のブックマークは元ツイートの投稿時刻を、
  // はてブは記事の公開時刻を持つので、時刻比較だと後から入った古い日付の項目を取りこぼす。
  // 既読集合は前回ページに載っていた行の data-k（空白区切り）。初回訪問は何も付けない。
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-feed-item][data-k]"));
  if (rows.length > 0) {
    const STORE = "todayai:seen";
    let seen: Set<string> | null = null;
    try {
      const raw = localStorage.getItem(STORE);
      if (raw !== null) seen = new Set(raw.split(" "));
    } catch {
      // 保存領域が使えない環境では新着表示をしない
    }

    let total = 0;
    if (seen) {
      for (const row of rows) {
        if (!seen.has(row.dataset.k ?? "")) {
          row.dataset.new = "";
          total++;
        }
      }
      const showPill = (pill: HTMLElement | null, n: number) => {
        if (!pill || n === 0) return;
        pill.textContent = `新着 ${n}`;
        pill.hidden = false;
      };
      for (const day of document.querySelectorAll<HTMLElement>("[data-day]")) {
        showPill(day.querySelector("[data-day-new]"), day.querySelectorAll("[data-feed-item][data-new]").length);
        showPill(
          day.querySelector("[data-more-new]"),
          day.querySelectorAll("[data-feed-item].is-collapsed[data-new]").length,
        );
      }
      const summary = document.querySelector<HTMLElement>("[data-new-summary]");
      const summaryCount = document.querySelector<HTMLElement>("[data-new-total]");
      if (summary && summaryCount && total > 0) {
        summaryCount.textContent = String(total);
        summary.hidden = false;
      }
    }

    // 今ページに載っている行を既読として保存。読んでいる最中に印が消えないよう、
    // ページを離れる（非表示になる）ときに書く。iOS は pagehide を飛ばすことがあるので両方で。
    const keys = rows.map((r) => r.dataset.k).join(" ");
    const save = () => {
      try {
        localStorage.setItem(STORE, keys);
      } catch {
        // 保存できなくても表示には影響しない
      }
    };
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") save();
    });
    addEventListener("pagehide", save);
  }
</script>
