---
import { siteLink } from "@/lib/url";
import type { MonthMeta } from "@/lib/feed";

interface Props {
  months: MonthMeta[];
  /** 表示中の月キー（アーカイブページで自分をリンクにしない用）。 */
  current?: string;
}

const { months, current } = Astro.props;

const chipBase =
  "inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-[12.5px] font-medium transition-colors";
---

<nav aria-label="月別アーカイブ" class="mt-12 border-t border-[var(--color-border)] pt-5">
  <h2 class="font-mono text-[12px] font-semibold tracking-wide text-[var(--color-text-muted)]">
    月別アーカイブ
  </h2>
  <ul class="mt-3 flex flex-wrap gap-2">
    {
      months.map((m) => (
        <li>
          {m.key === current ? (
            <span
              aria-current="page"
              class={`${chipBase} border-[var(--color-accent)] bg-[var(--color-accent-glow)] text-[var(--color-accent-bright)]`}
            >
              {m.label}
              <span class="font-mono text-[10.5px] tabular-nums">{m.count}</span>
            </span>
          ) : (
            <a
              href={siteLink(`/archive/${m.key}/`)}
              class={`${chipBase} border-[var(--color-border)] bg-[var(--color-card)] text-[var(--color-text-muted)] hover:border-[var(--color-border-strong)] hover:text-[var(--color-text)]`}
            >
              {m.label}
              <span class="font-mono text-[10.5px] tabular-nums text-[var(--color-text-subtle)]">
                {m.count}
              </span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
