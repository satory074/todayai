---
/**
 * 記事 1 件のリスト行（X 以外の全ソース）。見出しを走査しやすい密な行にするため、
 * 大きいカード＋16:9 サムネはやめ、「見出し → メタ行 → 要約 2 行」＋右に小さい実写サムネ。
 *
 * 行全体をクリック可能にする方法は「見出しのリンクを ::after で行全面に引き伸ばす」型
 * （globals.css の .row-link）。空の <a aria-label> を被せる旧方式は、読み上げ名（原文タイトル）と
 * 見えている文字（日本語訳）が食い違い WCAG 2.5.3 に反していた＝リンク名は見えている見出しそのもの。
 */
import type { FeedItem } from "@/lib/feed";
import { displayAuthor, displayThumb, sourceMeta, timeOfDay } from "@/lib/feed";
import BilingualText from "./BilingualText.astro";

interface Props {
  item: FeedItem;
  /** ソースバッジを出すか（同じソースだけが並ぶ場所では冗長なので消せる） */
  badge?: boolean;
  /** 初期折りたたみ（トップの はてブ/Zenn/Qiita 3日目以降。「もっと見せる」で展開） */
  collapsed?: boolean;
}

const { item, badge = true, collapsed = false } = Astro.props;
const meta = sourceMeta(item.source);
const thumb = displayThumb(item);
const author = displayAuthor(item);
const time = timeOfDay(item.publishedAt);
---

<article
  class:list={["row", collapsed && "is-collapsed"]}
  data-feed-item
  data-source={item.source}
>
  {
    thumb && (
      <img
        class="row-thumb"
        src={thumb}
        alt=""
        width="96"
        height="72"
        loading="lazy"
        decoding="async"
        onerror="this.remove()"
      />
    )
  }
  <h3 class="row-title">
    <a class="row-link" href={item.url} target="_blank" rel="noopener noreferrer">
      <BilingualText orig={item.title} ja={item.titleJa} />
    </a>
  </h3>
  <p class="row-meta">
    {badge && <span class={`badge ${meta.badgeClass}`}>{meta.label}</span>}
    {author && <span class="row-author">{author}</span>}
    {item.bookmarkCount !== undefined && <span>{item.bookmarkCount} users</span>}
    {time && <time datetime={item.publishedAt}>{time}</time>}
  </p>
  {
    item.summary && (
      <p class="row-summary">
        <BilingualText orig={item.summary} ja={item.summaryJa} />
      </p>
    )
  }
</article>
