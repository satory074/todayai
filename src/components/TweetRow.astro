---
/**
 * X の投稿 1 件のリスト行。ArticleRow と同じ「見出しリンクを行全面に引き伸ばす」型で、
 * 見出し＝表示名（読み上げ名と見えている文字が一致する）。時刻は 1 回だけ（旧カードは
 * タイムレールとカード下部で二重表示だった）。添付メディア／リンク先画像は右に小さく。
 * リンクプレビュー（本文 t.co の行き先）は文字だけの別リンクとして、行リンクの上に重ねる。
 */
import type { FeedItem } from "@/lib/feed";
import {
  avatarColor,
  avatarInitials,
  displayThumb,
  parseXAuthor,
  timeOfDay,
  xAccountKey,
} from "@/lib/feed";
import BilingualText from "./BilingualText.astro";

interface Props {
  item: FeedItem;
  /** 「前回以降の新着」判定用の短い識別子（トップだけ。itemKey） */
  k?: string;
}

const { item, k } = Astro.props;
const author = parseXAuthor(item.author);
const body = item.summary ?? item.title;
const bodyJa = item.summaryJa ?? item.titleJa;
const time = timeOfDay(item.publishedAt);
const thumb = displayThumb(item);

// リンクプレビューがあるときは本文の t.co を落として生 URL を隠す（空になれば本文ごと出さない）
const lp = item.linkPreview;
const stripTco = (s?: string) => (s ? s.replace(/\s*https?:\/\/t\.co\/\S+/g, "").trim() : s);
const displayBody = lp ? stripTco(body) : body?.trim();
const displayBodyJa = lp ? stripTco(bodyJa) : bodyJa?.trim();
const hasBody = !!(displayBody || displayBodyJa);
// リンク先タイトルが本文と同じ文言（ニュース媒体の告知ツイート等）なら二重に見せない
const norm = (t?: string) => (t ?? "").replace(/\s+/g, "");
const lpTitle =
  lp && (lp.title || lp.titleJa) && !(norm(displayBody).includes(norm(lp.title)) && norm(lp.title).length > 0);

const name = author.kind === "handle" ? (item.authorName ?? author.handle) : author.label;
const avatarBg = author.kind === "handle" ? avatarColor(author.handle ?? "") : "var(--color-avatar-fallback)";
const initials = author.kind === "handle" ? avatarInitials(author.handle ?? "") : "X";
---

<article class="row" data-feed-item data-source="x" data-x-account={xAccountKey(item)} data-k={k}>
  {
    thumb && (
      <img
        class="row-thumb"
        src={thumb}
        alt=""
        width="96"
        height="72"
        loading="lazy"
        decoding="async"
        onerror="this.remove()"
      />
    )
  }
  <div class="tweet-head">
    <span class="avatar" style={`background:${avatarBg}`} aria-hidden="true">
      {initials}
      {
        item.avatarUrl && (
          <img
            src={item.avatarUrl}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
            onerror="this.remove()"
          />
        )
      }
    </span>
    <h4 class="row-title tweet-name">
      <a class="row-link" href={item.url} target="_blank" rel="noopener noreferrer">{name}</a>
    </h4>
    <p class="row-meta">
      {author.kind === "handle" && <span class="row-author">@{author.handle}</span>}
      {time && <time datetime={item.publishedAt}>{time}</time>}
    </p>
  </div>
  {
    hasBody && (
      <p class="tweet-body">
        <BilingualText orig={displayBody} ja={displayBodyJa} />
      </p>
    )
  }
  {
    lp && (
      <a class="tweet-link" href={lp.url} target="_blank" rel="noopener noreferrer">
        <span class="tweet-link-domain">{lp.domain}</span>
        {lpTitle && (
          <span class="tweet-link-title">
            <BilingualText orig={lp.title} ja={lp.titleJa} />
          </span>
        )}
      </a>
    )
  }
</article>
