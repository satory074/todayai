---
import "@/styles/globals.css";
import { siteLink, absUrl } from "@/lib/url";
import { canonicalOf, jsonLdString, pageJsonLd, type SchemaType } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** ヘッダーに「原文」切替ボタンを出すか（翻訳のあるフィード一覧ページだけ） */
  langToggle?: boolean;
  /** 構造化データの型。トップは WebSite、アーカイブは CollectionPage、about は AboutPage */
  schemaType?: SchemaType;
  /** 構造化データの name（省略時は title）。画面の h1 と同じ言葉にする */
  schemaName?: string;
  /** 構造化データに足す項目（画面に出ている内容だけ） */
  schemaExtra?: Record<string, unknown>;
}

const {
  title = "today.ai — AI情報フィード",
  description = "AI関連の情報を X・Zenn・Qiita・はてなブックマーク・Google Workspace Updates・LayerX AI・LLM Newsletter・Google Cloud リリースノート・IPA から自動で集め、時系列で読める個人フィード。",
  langToggle = false,
  schemaType = "WebPage",
  schemaName,
  schemaExtra,
} = Astro.props;

// ヘッダーナビの現在地（aria-current）。Astro.url.pathname は base（/todayai）込み
const path = Astro.url.pathname.replace(/\/+$/, "");
const navItems = [
  { href: siteLink("/archive/"), label: "アーカイブ", current: path.startsWith(siteLink("/archive")) },
  { href: siteLink("/about/"), label: "About", current: path === siteLink("/about") },
  { href: siteLink("/rss.xml"), label: "RSS", current: false },
];

const ogImage = absUrl("/og-default.png");

// canonical / og:url。Astro.url.pathname は既に base（/todayai）込みなので absUrl() に
// 渡すと base が二重付与になる → Astro.site を基点に組む。トップの pathname は "/todayai"（/ 無し）で
// 来るので、canonicalOf() が末尾 / にそろえる（サイトマップ・GitHub Pages の 301 先と同じ URL）。
const canonicalURL = canonicalOf(Astro.url.pathname);
const jsonLd = pageJsonLd({
  type: schemaType,
  name: schemaName ?? title,
  url: canonicalURL,
  description,
  extra: schemaExtra,
});

// Cloudflare Web Analytics — Cookie 不要のプライバシー配慮解析（バナー不要）。
// PUBLIC_CF_BEACON_TOKEN（.env / リポジトリ変数）が入っていればビーコンを出力し、
// 未設定なら何も出さない＝ビルドは壊れない（graceful）。トークンはページソースに出る
// 公開値なので secret ではなくリポジトリ「変数」で渡す。
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- ライト／ダーク両対応（OS 設定に追従）。CSS より先に伝えて読み込み時の白フラッシュを抑える -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1115" />
    <!-- 表示言語（日本語／原文）を描画前に復元＝原文派の人に一瞬日本語が出てから切り替わるちらつきを出さない -->
    <script is:inline>
      try {
        if (localStorage.getItem("todayai:lang") === "orig") document.documentElement.classList.add("show-orig");
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={siteLink("/favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="today.ai"
      href={siteLink("/rss.xml")}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- 構造化データ（1 ページ 1 つ）。作者は satory074.com の #person -->
    <script is:inline type="application/ld+json" set:html={jsonLdString(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Google Fonts はレンダーブロッキングにしない: media="print" で非適用のまま読み込み、
         onload で全メディアに切替（フォールバックフォントで即描画→読み込み後に swap）。JS 無効時は noscript -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {
      cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
  </head>
  <body>
    <!-- キーボード利用者が長いヘッダー/フィルタを飛ばして本文へ行けるスキップリンク（フォーカス時だけ見える） -->
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-[var(--color-card)] px-3 py-2 text-sm font-medium text-[var(--color-accent-bright)] shadow focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
      >本文へスキップ</a
    >
    <div class="mx-auto flex min-h-screen max-w-[46rem] flex-col px-4 pb-[calc(3rem+env(safe-area-inset-bottom))] sm:px-6 lg:max-w-[58rem]">
      <!-- ヘッダーは固定しない（スクロールで流れる）。画面上端に残すのはチップバーだけ＝読む面積を最大化 -->
      <header id="app-header" class="py-3">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
          <a href={siteLink("/")} class="group flex items-center gap-2.5">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-brand)] font-mono text-sm font-bold text-white shadow-[0_2px_10px_var(--color-accent-glow)]"
              >ai</span
            >
            <span class="font-display text-base font-bold tracking-tight">
              today<span class="text-[var(--color-accent)]">.ai</span>
            </span>
          </a>
          <div class="flex items-center gap-1">
            <nav aria-label="サイト内" class="flex items-center font-mono text-xs text-[var(--color-text-muted)]">
              {
                navItems.map((n) => (
                  <a
                    href={n.href}
                    aria-current={n.current ? "page" : undefined}
                    class="rounded-md px-2 py-1.5 transition-colors hover:bg-[var(--color-card-hover)] hover:text-[var(--color-text)] aria-[current=page]:text-[var(--color-text)] aria-[current=page]:underline aria-[current=page]:underline-offset-4"
                  >
                    {n.label}
                  </a>
                ))
              }
            </nav>
            {
              langToggle && (
                <button
                  type="button"
                  id="lang-toggle"
                  aria-pressed="false"
                  title="翻訳前の原文で表示する"
                  class="ml-1 rounded-full border border-[var(--color-border)] bg-[var(--color-card)] px-2.5 py-1 text-xs font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-text)] aria-[pressed=true]:border-[var(--color-accent)] aria-[pressed=true]:bg-[var(--color-accent-glow)] aria-[pressed=true]:text-[var(--color-accent-bright)]"
                >
                  原文
                </button>
              )
            }
          </div>
        </div>
      </header>

      <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
        <slot />
      </main>

      <footer
        class="border-t border-[var(--color-border)] py-6 text-center text-xs text-[var(--color-text-subtle)]"
      >
        <p>
          today.ai — AI情報を1つのフィードに。X / Zenn / Qiita / はてブ / Workspace / LayerX / GCP
          から自動集約。
        </p>
      </footer>

      <!-- サイト間ナビ: 画面下端に常駐する控えめな逆リンクバー（→ satory074.com/apps）。
           フィードが長大で通常フッターは実質スクロール到達不能なため、tenji と同じく fixed で常時表示する -->
      <nav
        aria-label="サイト間ナビゲーション"
        class="app-backlink-bar fixed inset-x-0 bottom-0 z-40 border-t border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur"
        style="padding-bottom: env(safe-area-inset-bottom)"
      >
        <div class="mx-auto flex h-9 items-center justify-center px-4">
          <a
            href="https://satory074.com/apps/"
            target="_blank"
            rel="noopener"
            aria-label="satory074 のほかのアプリ一覧を新しいタブで開く"
            class="inline-flex h-full items-center gap-1 px-3 font-mono text-xs text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent-bright)]"
          >
            satory074 のほかのアプリ <span aria-hidden="true">↗</span>
          </a>
        </div>
      </nav>

      <!-- 追従する「トップへ戻る」ボタン。scrollY>600 で表示（位置・出し入れは globals.css の .back-to-top）。
           z-30 = 固定チップバー(z-20)/日付札(z-10)より前面、バックリンクバー(z-40)より下 -->
      <button
        type="button"
        id="back-to-top"
        aria-label="ページの先頭へ戻る"
        class="back-to-top fixed right-4 z-30 flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border-strong)] bg-[var(--color-card)] text-[var(--color-text-muted)] shadow-[0_4px_14px_rgba(20,22,27,0.12)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] sm:right-6"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    </div>
    <script>
      // 表示言語トグル（日本語 / 原文）。:root.show-orig を切り替え、選択は localStorage に保存。
      // 初期状態は <head> のインライン script が描画前に復元済み＝ここではボタンの押下状態を合わせるだけ。
      const langToggle = document.getElementById("lang-toggle");
      if (langToggle) {
        const root = document.documentElement;
        const sync = () => langToggle.setAttribute("aria-pressed", String(root.classList.contains("show-orig")));
        sync();
        langToggle.addEventListener("click", () => {
          const orig = !root.classList.contains("show-orig");
          root.classList.toggle("show-orig", orig);
          try {
            localStorage.setItem("todayai:lang", orig ? "orig" : "ja");
          } catch {
            // 保存できない環境（プライベートモード等）でも切替自体は効く
          }
          sync();
        });
      }

      // トップへ戻るボタンの出し入れ。rAF は使わない（非アクティブタブでは止まる）＝scroll で直接判定。
      const backToTop = document.getElementById("back-to-top");
      if (backToTop) {
        const sync = () => backToTop.classList.toggle("is-visible", window.scrollY > 600);
        window.addEventListener("scroll", sync, { passive: true });
        sync(); // リロードで途中位置が復元されたとき用
        backToTop.addEventListener("click", () => {
          // behavior 未指定＝html の scroll-behavior に従う（smooth。prefers-reduced-motion では auto）
          window.scrollTo({ top: 0 });
          // ボタンは隠れてフォーカスを失うので、キーボード利用者のフォーカスを先頭のロゴへ移す
          document.querySelector<HTMLElement>("#app-header a")?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>
