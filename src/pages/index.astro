---
import Layout from "@/components/Layout.astro";
import SourceFilter from "@/components/SourceFilter.astro";
import Timeline from "@/components/Timeline.astro";
import ArchiveNav from "@/components/ArchiveNav.astro";
import { formatStamp, isKnownSource, monthsOf, takeRecentWindow, type FeedData } from "@/lib/feed";
import { readFeed } from "@/lib/feedStore";

// ビルド時にデータを取得。GCS_BUCKET 設定時は GCS の public URL、未設定ならローカル feed.json。
// 集約と同じ run のビルドが書き込み直後の最新を読むよう GITHUB_RUN_ID でキャッシュバスト。
const feed = await readFeed<FeedData>(
  { updatedAt: new Date(0).toISOString(), items: [] },
  { bust: process.env.GITHUB_RUN_ID },
);
// 退役ソース（SOURCES 未登録）のアイテムは描画しない＝バッジ lookup のクラッシュとゴースト行を防ぐ。
const allItems = [...feed.items]
  .filter((i) => isKnownSource(i.source))
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

// 全件（数千件）を1ページに描画すると HTML が10MB超・DOM 数万ノードになり読み込みが数秒かかる。
// トップは直近7 JST暦日のみ（基準は最新アイテムの暦日）。全ソースを時刻順に混ぜて並べ、流量の多い
// はてブ・Zenn・Qiita は直近2日だけ出して残りを日ごとの「もっと見せる」に畳む（collapsedIds）。過去分は月別アーカイブへ。
const { items, collapsedIds } = takeRecentWindow(allItems);
const months = monthsOf(allItems);

// 更新時刻はビルド時には絶対表記で出す（相対表記をビルド時に決めると、6 時間ごとの静的ビルドなので
// 閲覧時には常に「たった今」等のままずれる）。
---

<Layout langToggle schemaType="WebSite">
  <section class="pb-3 pt-2">
    <h1 class="font-display text-[1.625rem] font-bold tracking-tight text-[var(--color-text)]">
      AI情報フィード
    </h1>
    <p class="mt-1 text-[0.8125rem] text-[var(--color-text-muted)]">
      X・Zenn・Qiita・はてブ・Workspace・LayerX・GCP から自動集約。
      {
        feed.updatedAt && (
          <span class="font-mono text-xs text-[var(--color-text-subtle)]">
            <time datetime={feed.updatedAt} data-updated>
              {formatStamp(feed.updatedAt)}
            </time>{" "}
            更新
          </span>
        )
      }
      <span data-new-summary hidden class="font-mono text-xs text-[var(--color-accent-bright)]">
        · 前回以降の新着 <span data-new-total></span> 件
      </span>
    </p>
  </section>

  <SourceFilter items={items} />

  {
    items.length === 0 ? (
      <div class="rounded-xl border border-dashed border-[var(--color-border)] bg-[var(--color-card)] p-10 text-center text-[var(--color-text-muted)]">
        <p>まだアイテムがありません。</p>
        <p class="mt-1 text-xs text-[var(--color-text-subtle)]">
          <code>npm run aggregate</code> を実行するとフィードが取り込まれます。
        </p>
      </div>
    ) : (
      <Timeline items={items} collapsedIds={collapsedIds} markNew />
    )
  }

  {months.length > 0 && <ArchiveNav months={months} />}
</Layout>
