---
/**
 * 月別アーカイブの一覧（/archive/）。ヘッダーの「アーカイブ」から来る入口。
 * かつては /archive/ が 404 で、月一覧はトップの 750 件の一番下にしか無かった（実質到達不能）。
 */
import Layout from "@/components/Layout.astro";
import { isKnownSource, monthsOf, type FeedData, type MonthMeta } from "@/lib/feed";
import { readFeed } from "@/lib/feedStore";
import { siteLink } from "@/lib/url";

const feed = await readFeed<FeedData>(
  { updatedAt: new Date(0).toISOString(), items: [] },
  { bust: process.env.GITHUB_RUN_ID },
);
const items = [...feed.items]
  .filter((i) => isKnownSource(i.source))
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

// 年ごとにまとめる（新しい年・新しい月が先）
const byYear = new Map<string, MonthMeta[]>();
for (const m of monthsOf(items)) {
  const year = m.key.slice(0, 4);
  const list = byYear.get(year);
  if (list) list.push(m);
  else byYear.set(year, [m]);
}
---

<Layout title="アーカイブ | today.ai" description="today.ai に集約した AI 関連情報の月別アーカイブ。">
  <section class="pb-3 pt-2">
    <h1 class="font-display text-[1.625rem] font-bold tracking-tight text-[var(--color-text)]">アーカイブ</h1>
    <p class="mt-1 text-[0.8125rem] text-[var(--color-text-muted)]">
      トップには直近 7 日分だけを載せています。それより前はここから月ごとに読めます。
    </p>
  </section>

  {
    [...byYear.entries()].map(([year, months]) => (
      <section class="mt-6">
        <h2 class="border-b-2 border-[var(--color-text)] pb-1 font-display text-xl font-bold">{year}年</h2>
        <ul class="mt-1">
          {months.map((m) => (
            <li class="border-b border-[var(--color-border)]">
              <a
                href={siteLink(`/archive/${m.key}/`)}
                class="flex items-baseline justify-between gap-3 py-3 transition-colors hover:text-[var(--color-accent-bright)]"
              >
                <span class="font-semibold">{m.label}</span>
                <span class="font-mono text-xs tabular-nums text-[var(--color-text-subtle)]">{m.count}件</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
